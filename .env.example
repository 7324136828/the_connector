# ==========================================
# The Connector - Environment Configuration
# ==========================================

# Server settings: 0.0.0.0 enables LAN; use --local or --host 127.0.0.1 for local access.
HOST=0.0.0.0
# BACKEND_HOST takes precedence over HOST in development and packaged launchers.
# BACKEND_HOST=0.0.0.0
# Ports come from settings.json; explicit CLI port flags override them for that run.
# Development tries the next free ports. Packaged builds require available ports.
# CORS_ORIGINS=["http://localhost:5130","http://127.0.0.1:5130"]
CONNECTOR_DEBUG=false

# User preferences: %APPDATA%\the_connector\settings.json on Windows;
# $XDG_CONFIG_HOME/the_connector/settings.json or ~/.config/the_connector/settings.json elsewhere.
# Launchers create {} if missing, then add only missing fields from port_mapping.json:
# {"react_port":5130,"connector_port":8130,"kokoro_port":8131}
# Development reads the root mapping; portable builds ship/read it beside server.exe.
# Edit the root mapping for future build defaults; rebuilds replace installed mapping files.
# The mapping is validated before build/startup and never overwrites saved user ports.
# Existing port values and unrelated JSON fields are preserved and reread on launch.
# Edit these port fields and restart, or override a port with an explicit CLI flag.
# Save Data storage folder in the UI, or add "data_dir":"D:/Connector Data" to JSON.
# Missing/empty data_dir uses %TEMP%\the_connector (system temp/the_connector elsewhere).
# Restart after changing storage; existing data is not automatically moved.
# CONNECTOR_SETTINGS_PATH=C:/path/to/settings.json
# DATA_DIR overrides the JSON preference. Per-path overrides below take precedence.
# DATA_DIR=C:/path/to/Connector Data
# The database defaults to <data_dir>/connector.db.
# DB_PATH=C:/path/to/connector.db
# Installed plugin files/environments default to <data_dir>/plugins.
# PLUGIN_DIR=C:/path/to/Connector Data/plugins

# Agent Python defaults to <data_dir>/python; named environments to <data_dir>/python_envs.
# AGENT_PYTHON_ENV_DIR=C:/path/to/Connector Data/python
# AGENT_PYTHON_ENVS_DIR=C:/path/to/Connector Data/python_envs
# Packaged agent/plugin execution requires an installed Python interpreter.
# CONNECTOR_PYTHON_EXECUTABLE=C:/path/to/Python312/python.exe
# Session/export scratch folders default to <data_dir>/jobs.
# JOBS_DIR=C:/path/to/Connector Data/jobs

# Selected endpoint responses are logged under <data_dir>/logs.
# Skip database access during compatible completion requests (routing is cached).
COMPLETION_NO_DATABASE_ACCESS=false
RESPONSE_LOGGING_ENABLED=true
# RESPONSE_LOG_DIR=C:/path/to/logs
RESPONSE_LOG_MAX_BYTES=10485760
RESPONSE_LOG_BACKUP_COUNT=5
# 0 logs complete bodies; set a byte limit to capture only a response prefix.
RESPONSE_LOG_MAX_BODY_BYTES=0
# Request bodies are captured alongside responses. 0 means complete bodies.
REQUEST_LOG_MAX_BODY_BYTES=0
# Internal diagnostic table in DB_PATH; never exposed through app APIs or memory.
INTERNAL_AUDIT_ENABLED=true
# Keep at most five newest records and 10 MiB of serialized audit payload.
INTERNAL_AUDIT_MAX_BYTES=10485760
INTERNAL_AUDIT_MAX_ENTRIES=5

# LLM Provider API Keys (Set any that you wish to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama Local Host
OLLAMA_HOST=http://localhost:11434

# Required isolated Kokoro speech server (included in portable builds).
# By default the API uses the saved kokoro_port at http://127.0.0.1:<port> (8131 initially).
# Portable builds start bundled Kokoro automatically unless an explicit URL is set.
# Set an explicit URL only to connect to an external service you start separately.
# Full-stack development launchers instead use their selected speech process URL.
# KOKORO_BASE_URL=http://127.0.0.1:8131
# Default narrator when neither the request nor model response specifies an actor.
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_TIMEOUT=120

# Default Provider & Model
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_CONTEXT_WINDOW=10
