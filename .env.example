# ==========================================
# The Connector - Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8301
CONNECTOR_DEBUG=false

# Database defaults to the system temp directory: %TEMP%\the_connector\connector.db
# (tempfile.gettempdir()/the_connector/connector.db on other systems).
# Optional persistent location override; leave unset to use system temp.
# DB_PATH=C:/path/to/connector.db

# Agent Python runs in %TEMP%\the_connector_python by default.
# AGENT_PYTHON_ENV_DIR=C:/path/to/the_connector_python
# Additional named environments are created under %TEMP%\the_connector_python_envs.
# AGENT_PYTHON_ENVS_DIR=C:/path/to/the_connector_python_envs

# Selected endpoint responses are logged under %TEMP%\the_connector\logs.
# Skip database access during compatible completion requests (routing is cached).
COMPLETION_NO_DATABASE_ACCESS=false
RESPONSE_LOGGING_ENABLED=true
# RESPONSE_LOG_DIR=C:/path/to/logs
RESPONSE_LOG_MAX_BYTES=10485760
RESPONSE_LOG_BACKUP_COUNT=5
# 0 logs complete bodies; set a byte limit to capture only a response prefix.
RESPONSE_LOG_MAX_BODY_BYTES=0
# Request bodies are captured alongside responses. 0 means complete bodies.
REQUEST_LOG_MAX_BODY_BYTES=0
# Internal diagnostic table in DB_PATH; never exposed through app APIs or memory.
INTERNAL_AUDIT_ENABLED=true
# Keep at most five newest records and 10 MiB of serialized audit payload.
INTERNAL_AUDIT_MAX_BYTES=10485760
INTERNAL_AUDIT_MAX_ENTRIES=5

# LLM Provider API Keys (Set any that you wish to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama Local Host
OLLAMA_HOST=http://localhost:11434

# Required isolated Kokoro speech server
KOKORO_BASE_URL=http://127.0.0.1:8302
# Default narrator when neither the request nor model response specifies an actor.
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_TIMEOUT=120

# Default Provider & Model
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_CONTEXT_WINDOW=10
# Optional persistent location for installed plugins and their Python environments.
# PLUGIN_DIR=C:/path/to/the_connector/plugins
